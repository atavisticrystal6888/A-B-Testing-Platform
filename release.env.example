# Copy this file to release.env before building the release stack.

PHX_HOST=localhost
DATABASE_URL=ecto://experimenthub:experimenthub_dev@postgres/experiment_hub_dev
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-at-least-64-bytes-long-before-production-use
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes-before-production-use

REDIS_URL=redis://redis:6379
STAT_ENGINE_URL=http://statistical-engine:8000
STAT_ENGINE_API_KEY=replace-with-the-shared-internal-api-key

# Optional. When set, a JSON POST fires on significant primary-metric
# results and guardrail breaches (Slack incoming webhook, PagerDuty,
# a custom receiver, etc). Leave blank to disable alerting.
ALERT_WEBHOOK_URL=

KAFKA_BROKERS=kafka:29092
KAFKA_GROUP_ID=experimenthub-event-collector
KAFKA_TOPICS=experimenthub.events.inbound
# Set to false to disable the Broadway Kafka consumer pipeline (producer stays on).
KAFKA_CONSUMER_ENABLED=true

# Data pipeline (Python worker) — plain postgres:// URL (psycopg2, not ecto://).
PIPELINE_DATABASE_URL=postgresql://experimenthub:experimenthub_dev@postgres:5432/experiment_hub_dev
# Topic the rollup consumer reads. Must stay the *validated* topic
# event_collector's producer writes to (experimenthub.events.raw), not the
# pre-validation KAFKA_TOPICS topic above — only override if you know why.
KAFKA_EVENT_TOPIC=experimenthub.events.raw
ROLLUP_FLUSH_MAX_EVENTS=500
ROLLUP_FLUSH_INTERVAL_SECONDS=10

POOL_SIZE=10
DB_SSL=false
DNS_CLUSTER_QUERY=

# Host port for bundled Postgres only; containers still use postgres:5432.
POSTGRES_PORT=15432

DASHBOARD_PORT=8080
CORS_ORIGINS=http://localhost:8080
# Runtime API URL injected into the dashboard's /env.js at container start
# (preferred; one image serves any environment). Empty = same-origin.
DASHBOARD_APP_API_URL=
# Legacy build-time fallback, still honored if DASHBOARD_APP_API_URL is unset.
DASHBOARD_VITE_API_URL=