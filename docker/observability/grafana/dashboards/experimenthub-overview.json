{
  "title": "ExperimentHub Overview",
  "uid": "experimenthub-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(phoenix_endpoint_stop_duration_count[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(phoenix_endpoint_stop_duration_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(phoenix_endpoint_stop_duration_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(phoenix_endpoint_stop_duration_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(phoenix_router_dispatch_stop_duration_count[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "DB query latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(experiment_hub_repo_query_total_time_bucket[5m])) by (le))",
          "legendFormat": "total_time p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(experiment_hub_repo_query_queue_time_bucket[5m])) by (le))",
          "legendFormat": "queue_time p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "BEAM memory (avg over window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(vm_memory_total_sum[5m]) / rate(vm_memory_total_count[5m])",
          "legendFormat": "vm.memory.total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Run queue lengths",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(vm_total_run_queue_lengths_cpu_sum[5m]) / rate(vm_total_run_queue_lengths_cpu_count[5m])",
          "legendFormat": "cpu",
          "refId": "A"
        },
        {
          "expr": "rate(vm_total_run_queue_lengths_io_sum[5m]) / rate(vm_total_run_queue_lengths_io_count[5m])",
          "legendFormat": "io",
          "refId": "B"
        }
      ]
    }
  ]
}
